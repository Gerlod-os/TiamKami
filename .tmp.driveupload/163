            `
                : ""
            }
            
            ${
              game.youtube || game.mi || game.MI_Conducted
                ? `
                <div class="flex flex-col sm:flex-row gap-4 pt-4">
                    ${youtubeButton}
                    ${miButton}
                </div>
            `
                : ""
            }
