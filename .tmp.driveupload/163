    : "";

  const miButton =
    game.mi || game.MI_Conducted
      ? `<a href="${game.mi_link || "#"}" target="_blank" rel="noopener" class="flex-1 inline-flex items-center justify-center gap-2 bg-cyan-900/50 hover:bg-cyan-800/50 border border-cyan-600 text-cyan-400 font-bold px-6 py-4 rounded-lg transition-all">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            ТУРНИР: МИ
        </a>`
      : "";

  content.innerHTML = `
        <div class="space-y-6">
            <div class="border-b border-gray-800 pb-6">
                <h2 class="text-3xl md:text-4xl font-black text-white mb-4 uppercase tracking-tight">${displayName}</h2>
                <div class="flex flex-wrap items-center gap-4">
                    <span class="px-4 py-2 rounded font-bold uppercase tracking-wider border ${statusColor} text-sm">${game.status || "—"}</span>
                    ${game.score ? `<div class="flex items-center gap-2 bg-yellow-900/30 px-4 py-2 rounded border border-yellow-700/50"><span class="text-yellow-400 font-black text-3xl">${game.score}</span><span class="text-gray-500 text-lg font-bold">/10</span></div>` : ""}
                    ${game.progress ? `<span class="text-gray-400 font-mono bg-gray-800 px-3 py-2 rounded text-sm">ПРОГРЕСС: <span class="text-cyan-400 font-bold">${game.progress}%</span></span>` : ""}
                </div>
            </div>
            
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                ${game.genre ? `<div class="bg-gray-800/50 rounded-lg p-4 border border-gray-700"><div class="text-[10px] text-gray-500 uppercase tracking-wider mb-1 font-mono">ЖАНР</div><div class="text-white font-bold">${game.genre}</div></div>` : ""}
                ${game.setting ? `<div class="bg-gray-800/50 rounded-lg p-4 border border-gray-700"><div class="text-[10px] text-gray-500 uppercase tracking-wider mb-1 font-mono">СЕТТИНГ</div><div class="text-white font-bold">${game.setting}</div></div>` : ""}
                ${game.hours ? `<div class="bg-gray-800/50 rounded-lg p-4 border border-gray-700"><div class="text-[10px] text-gray-500 uppercase tracking-wider mb-1 font-mono">НАИГРАНО</div><div class="text-cyan-400 font-bold text-xl">${game.hours} ч.</div></div>` : ""}
