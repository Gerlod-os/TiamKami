let allGames = [];
let currentStatus = "all";
let currentGenre = "all";
let currentSearch = "";
let currentSort = "default";

document.addEventListener("DOMContentLoaded", () => {
  loadGamesData();
});

async function loadGamesData() {
  try {
    const response = await fetch("data/games.json");
    allGames = await response.json();
    // Назначаем ID, если их нет в JSON
        allGames = allGames.map((game, index) => {
      const originalSteamId = game.steam_id;
      return { id: index + 1, ...game, steam_id: originalSteamId };
    });


    updateStats();
    renderHallOfFame();
    fillGenreTags();
    applyFilters();
  } catch (error) {
    console.error("Ошибка загрузки базы рогаликов:", error);
    document.getElementById("games-grid").innerHTML =
      '<p class="text-red-400 col-span-full text-center py-10 font-mono text-lg">Ошибка загрузки данных. Проверьте консоль (F12).</p>';
  }
}

function updateStats() {
  if (!allGames.length) return;
  document.getElementById("stat-total").textContent = allGames.length;
  document.getElementById("stat-completed").textContent = allGames.filter(
    (g) => g.status === "Пройдено",
  ).length;
  document.getElementById("stat-dropped").textContent = allGames.filter(
    (g) => g.status === "Дропнуто",
  ).length;
  document.getElementById("stat-review").textContent = allGames.filter(
    (g) => g.status === "Обзор",
  ).length;

  const totalHours = allGames.reduce(
    (sum, g) => sum + (parseInt(g.hours) || 0),
    0,
  );
  document.getElementById("stat-hours").textContent = totalHours;
}

// Заполняем теги жанров из данных
function fillGenreTags() {
  const genres = new Set();
  allGames.forEach((game) => {
    if (game.genre)
      game.genre.split(",").forEach((g) => {
        if (g.trim()) genres.add(g.trim());
      });
  });
  const container = document.getElementById("genre-tags");
  if (!container) return;
  Array.from(genres)
    .sort()
    .forEach((genre) => {
      const btn = document.createElement("button");
      btn.dataset.genre = genre;
      btn.className =
        "genre-tag bg-gray-800 text-gray-300 hover:bg-gray-700 text-xs px-3 py-1.5 rounded-full transition";
      btn.textContent = genre;
      container.appendChild(btn);
    });
}

// Комбинированная фильтрация: поиск -> статус -> жанр -> сортировка
function applyFilters() {
  let filtered = [...allGames];
  if (currentSearch) {
    const s = currentSearch.toLowerCase();
    filtered = filtered.filter((g) => {
      const name = (g.name || "").toLowerCase();
      const genre = (g.genre || "").toLowerCase();
      const features = (g.features || "").toLowerCase();
      const setting = (g.setting || "").toLowerCase();
      const genreMatch = genre
        .split(",")
        .some((gen) => gen.trim().includes(s) || s.includes(gen.trim()));
      const featuresMatch = features
        .split(",")
        .some((feat) => feat.trim().includes(s) || s.includes(feat.trim()));
      return (
        name.includes(s) || genreMatch || featuresMatch || setting.includes(s)
      );
    });
  }
  if (currentStatus !== "all")
    filtered = filtered.filter((g) => g.status === currentStatus);
  if (currentGenre !== "all") {
    filtered = filtered.filter((g) => {
      if (!g.genre) return false;
      return g.genre
        .split(",")
        .map((x) => x.trim())
        .includes(currentGenre);
    });
  }
  if (currentSort !== "default") {
    filtered.sort((a, b) => {
      if (currentSort === "name-asc")
        return (a.name || "").localeCompare(b.name || "");
      if (currentSort === "name-desc")
        return (b.name || "").localeCompare(a.name || "");
      if (currentSort === "score-desc")
        return (parseInt(b.score) || 0) - (parseInt(a.score) || 0);
      if (currentSort === "hours-desc")
        return (parseInt(b.hours) || 0) - (parseInt(a.hours) || 0);
      if (currentSort === "date-new")
        return (
          new Date(b.played_date || "0000-01-01") -
          new Date(a.played_date || "0000-01-01")
        );
      return 0;
    });
  }
  renderGames(filtered);
  updateFiltersCount();
}

function updateFiltersCount() {
  const countEl = document.getElementById("active-filters-count");
  if (!countEl) return;
  let count = 0;
  if (currentStatus !== "all") count++;
  if (currentGenre !== "all") count++;
  if (currentSort !== "default") count++;
  if (count > 0) {
    countEl.textContent = count;
    countEl.classList.remove("hidden");
  } else {
    countEl.classList.add("hidden");
  }
}

function formatDate(dateStr) {
  if (!dateStr) return "—";
  const date = new Date(dateStr);
  if (isNaN(date.getTime())) return dateStr;
  return date.toLocaleDateString("ru-RU", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}

function renderGames(games) {
  const grid = document.getElementById("games-grid");
  document.getElementById("counter").textContent =
    `Найдено игр: ${games.length}`;
  if (games.length === 0) {
    grid.innerHTML =
      '<p class="text-gray-500 col-span-full text-center py-10 font-mono text-lg">НИЧЕГО НЕ НАЙДЕНО</p>';
    return;
  }
  grid.innerHTML = games
    .map((game) => {
      const statusColors = {
        Пройдено: "bg-emerald-900/50 text-emerald-400 border-emerald-700",
        Дропнуто: "bg-red-950/70 text-red-400 border-red-800",
        Обзор: "bg-blue-900/50 text-blue-400 border-blue-800",
        "Жду релиз": "bg-yellow-900/50 text-yellow-400 border-yellow-800",
        "В процессе": "bg-purple-900/50 text-purple-400 border-purple-800",
      };
      const statusColor =
        statusColors[game.status] ||
        "bg-gray-800 text-gray-400 border-gray-700";
      const displayName =
        game.name === "[REDACTED]"
          ? "СКРЫТАЯ ИГРА"
          : game.name || "БЕЗ НАЗВАНИЯ";
      const statusAttr =
        game.status === "Дропнуто" ? 'data-status="Дропнуто"' : "";
      const scoreAttr = String(game.score) === "10" ? 'data-score="10"' : "";
      const miBadge =
        game.mi || game.MI_Conducted
          ? `<span class="mi-badge text-[10px] px-2 py-1 rounded font-bold tracking-wider">[ COMPETITION: МИ ]</span>`
          : "";
      const featuresHtml = game.features
        ? game.features
            .split(",")
            .slice(0, 3)
            .map(
              (f) =>
                `<span class="text-[10px] bg-gray-800/80 text-cyan-400 px-2 py-1 rounded border border-cyan-900/50 font-mono">${f.trim()}</span>`,
            )
            .join("")
        : "";
      const isGold = String(game.score) === "10";
      const crystalColor = isGold ? "text-yellow-400" : "text-purple-500";
      const scoreHtml = game.score
        ? `<div class="flex items-center gap-1">
<svg class="w-5 h-5 inline ${crystalColor}" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L2 12l10 10 10-10L12 2zm0 3.65L18.35 12 12 18.35 5.65 12 12 5.65z"/></svg>
<span class="${isGold ? "text-yellow-400" : "text-white"} font-black text-2xl">${game.score}</span>
<span class="text-gray-600 text-sm font-bold">/10</span>
</div>`
        : '<span class="text-gray-600 text-sm font-mono">N/A</span>';
      // Генерируем URL обложки Steam (используем надежный CDN Akamai)
      const steamCoverUrl = game.steam_id
        ? `https://cdn.akamai.steamstatic.com/steam/apps/${game.steam_id}/header.jpg`
        : "";
      return `
        <div class="game-card bg-gray-900/80 border border-gray-800 hover:border-purple-600/50 hover:shadow-2xl hover:shadow-purple-900/20 cursor-pointer group ${statusAttr} ${scoreAttr}" 
             onclick="openGame(${game.id})">
          <!-- Блок обложки с защитой от ошибок -->
          <div class="relative w-full h-36 overflow-hidden rounded-t-lg bg-gray-900 shrink-0">
            <img 
              src="${steamCoverUrl}" 
              alt="${displayName}"
              class="game-thumbnail w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 absolute inset-0"
              onerror="this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex';"
            >
            <div style="display:none;" class="game-thumbnail w-full h-full bg-gradient-to-br from-purple-900 via-purple-600 to-pink-600 absolute inset-0 items-center justify-center">
              <span class="text-white/40 text-2xl font-black tracking-widest uppercase">NO COVER</span>
            </div>
          </div>
          <div class="p-5 space-y-4">
            <div class="flex justify-between items-start gap-2">
              <h3 class="text-lg font-black group-hover:text-pink-400 transition-colors line-clamp-2 uppercase tracking-tight">${displayName}</h3>
              ${miBadge}
            </div>
            <div class="text-sm text-gray-400 font-mono">
              <span class="text-purple-400">${game.genre || "—"}</span>
              ${game.hours ? `<span class="text-gray-600"> • </span><span class="text-cyan-400">${game.hours} ч.</span>` : ""}
            </div>
            <div class="flex flex-wrap gap-2">${featuresHtml}</div>
            <div class="flex justify-between items-center pt-4 border-t border-gray-800">
              ${scoreHtml}
              <span class="text-[10px] px-3 py-1.5 rounded font-bold uppercase tracking-wider border ${statusColor}">${game.status || "—"}</span>
            </div>
          </div>
        </div>
      `;
    })
    .join("");
}

function openGame(id) {
  const game = allGames.find((g) => g.id === id);
  if (!game) return;

  const modal = document.getElementById("game-modal");
  const content = document.getElementById("modal-content");
  const displayName =
    game.name === "[REDACTED]" ? "СКРЫТАЯ ИГРА" : game.name || "БЕЗ НАЗВАНИЯ";

  const statusColors = {
    Пройдено: "bg-emerald-900/50 text-emerald-400 border-emerald-700",
    Дропнуто: "bg-red-950/70 text-red-400 border-red-800",
    Обзор: "bg-blue-900/50 text-blue-400 border-blue-800",
    "Жду релиз": "bg-yellow-900/50 text-yellow-400 border-yellow-800",
    "В процессе": "bg-purple-900/50 text-purple-400 border-purple-800",
  };
  const statusColor =
    statusColors[game.status] || "bg-gray-800 text-gray-400 border-gray-700";

  const featuresHtml = game.features
    ? game.features
        .split(",")
        .map(
          (f) =>
            `<span class="text-xs bg-gray-800 text-cyan-400 px-3 py-1.5 rounded border border-cyan-900/50 font-mono">${f.trim()}</span>`,
        )
        .join("")
    : "";

  const youtubeButton = game.youtube
    ? `<a href="${game.youtube}" target="_blank" rel="noopener" class="btn-youtube-analysis flex-1 inline-flex items-center justify-center gap-3 px-6 py-4 rounded-lg font-bold text-sm text-white">
