                ${game.release_date ? `<div class="bg-gray-800/50 rounded-lg p-4 border border-gray-700"><div class="text-[10px] text-gray-500 uppercase tracking-wider mb-1 font-mono">РЕЛИЗ</div><div class="text-white font-bold">${formatDate(game.release_date)}</div></div>` : ""}
                ${game.played_date ? `<div class="bg-gray-800/50 rounded-lg p-4 border border-gray-700"><div class="text-[10px] text-gray-500 uppercase tracking-wider mb-1 font-mono">ДАТА ИГРЫ</div><div class="text-white font-bold">${formatDate(game.played_date)}</div></div>` : ""}
            </div>

            ${featuresHtml ? `<div><div class="text-[10px] text-gray-500 uppercase tracking-wider mb-3 font-mono">Особенности</div><div class="flex flex-wrap gap-2">${featuresHtml}</div></div>` : ""}
            
            ${
              game.notes
                ? `
                <div>
                    <div class="text-[10px] text-gray-500 uppercase tracking-wider mb-3 font-mono">Комментарии стримера</div>
